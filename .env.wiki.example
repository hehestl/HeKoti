# Hekoti — wiki prod hemonea (Profile A: /opt/app/prod/hh/core/wiki)
# cp .env.wiki.example .env && заполните секреты

HEKOTI_INSTANCE=wiki
COMPOSE_PROJECT_NAME=hh-wiki
HEKOTI_HOST_PORT=3310
HEKOTI_PUBLIC_HOST=wiki.hehestl.su
TRAEFIK_PROXY_NETWORK=hehe-net

# Внешний Postgres + Redis (deploy/docker-compose.external-deps.yml)
HEKOTI_DB_DOCKER_NETWORK=hh-network
POSTGRES_HOST=hedra-postgres-postgres-1
POSTGRES_DB=hekoti_wiki_db
POSTGRES_USER=hekoti_wiki_user
POSTGRES_PASSWORD=change-me-unique-password

HEKOTI_LT_MODE=off
COMPOSE_PROFILES=

NODE_ENV=production
PORT=3310
APP_URL=https://wiki.hehestl.su

SESSION_COOKIE_NAME=hekoti_wiki_session
SESSION_TTL_HOURS=720

PUBLIC_READ_MODE=true
ENABLED_LANGUAGES=en,ru

HEKOTI_ADMIN_EMAIL=admin
HEKOTI_ADMIN_PASSWORD=change-me-after-first-login

REDIS_URL=redis://hekoti-redis:6379
REDIS_CACHE_TTL_SECONDS=300

HEKOTI_SKIP_MIGRATE=0
LOCAL_UPLOAD_DIR=public/uploads
MEDIA_STORAGE=local

DONATE_LINKS_JSON=[]
CRYPTO_DONATION_JSON=[]
AI_LINKS_JSON=[]
AI_AGENTS_JSON=[]

# --- Heron Auth SSO (SSOT: only .env — no domains in source/Dockerfile) ---
# NEXT_PUBLIC_* bake at `docker compose build` (compose build.args).
HEKOTI_HERON_AUTH_ENABLED=1
HEKOTI_HERON_DEFAULT_RETURN=/ru/admin
NEXT_PUBLIC_APP_URL=https://wiki.hehestl.su
NEXT_PUBLIC_HERON_AUTH_URL=https://id.hehestl.su
NEXT_PUBLIC_HERON_OAUTH_CLIENT_ID=hekoti-wiki
# BFF server-only (hemonea: public IdP — loose coupled)
HERON_AUTH_API_URL=https://id.hehestl.su
HERON_JWT_ISSUER=https://id.hehestl.su
HERON_JWT_AUDIENCE=hekoti-wiki
HERON_OAUTH_CLIENT_ID=hekoti-wiki
HERON_JWT_PUBLIC_KEY_HOST_PATH=/opt/app/prod/hh-heron-auth/secrets/heron_jwt_public.pem
HERON_JWT_PUBLIC_KEY_PATH=/run/secrets/heron_jwt_public.pem
