# Hekoti — wiki на hedra (внешний Postgres, порт 3310)
# cp .env.wiki.example .env && заполните POSTGRES_PASSWORD и APP_URL

HEKOTI_INSTANCE=wiki
COMPOSE_PROJECT_NAME=hh-wiki
HEKOTI_HOST_PORT=3310
NPM_PROXY_NETWORK=proxy-network

# Внешний Postgres (deploy/docker-compose.external-db.yml)
HEKOTI_DB_DOCKER_NETWORK=hh-network
POSTGRES_HOST=hedra-postgres-postgres-1
POSTGRES_DB=hekoti_wiki_db
POSTGRES_USER=hekoti_wiki_user
POSTGRES_PASSWORD=change-me-unique-password

HEKOTI_LT_MODE=embedded
COMPOSE_PROFILES=embedded-lt

NODE_ENV=production
PORT=3310
APP_URL=https://wiki.hehestl.com

SESSION_COOKIE_NAME=hekoti_wiki_session
SESSION_TTL_HOURS=720

PUBLIC_READ_MODE=true
ENABLED_LANGUAGES=en,ru

HEKOTI_ADMIN_EMAIL=admin
HEKOTI_ADMIN_PASSWORD=change-me-after-first-login

REDIS_URL=redis://hekoti-redis:6379
REDIS_CACHE_TTL_SECONDS=300

HEKOTI_SKIP_MIGRATE=0
LOCAL_UPLOAD_DIR=public/uploads
MEDIA_STORAGE=local

DONATE_LINKS_JSON=[]
CRYPTO_DONATION_JSON=[]
AI_LINKS_JSON=[]
AI_AGENTS_JSON=[]
HEKOTI_HERON_AUTH_ENABLED=0
HEKOTI_HERON_DEFAULT_RETURN=/ru/admin
