NODE_ENV=production
PORT=3310
APP_URL=http://localhost:3310

DATABASE_URL=postgresql://hekoti_user:hekoti_password@hekoti-postgres:5432/hekoti_db?schema=public
SESSION_COOKIE_NAME=hekoti_session
SESSION_TTL_HOURS=720

# Optional Redis
REDIS_URL=redis://hekoti-redis:6379
REDIS_CACHE_TTL_SECONDS=300
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_ATTEMPTS=8

# Mode
PUBLIC_READ_MODE=true
ENABLED_LANGUAGES=en,ru,de,fr,es,pt-BR,pt-PT,it,ja,ko,zh-CN

# Seed admin
HEKOTI_ADMIN_EMAIL=admin@hekoti.local
HEKOTI_ADMIN_PASSWORD=change-me-now

# Donations and AI menu
DONATE_LINKS_JSON=[{"title":"Boosty","url":"https://boosty.to/yourname"},{"title":"Patreon","url":"https://patreon.com/yourname"}]
CRYPTO_DONATION_JSON=[{"asset":"USDT","network":"TON","address":"UQ..."}]
AI_LINKS_JSON=[{"title":"ChatGPT","url":"https://chat.openai.com"},{"title":"Claude","url":"https://claude.ai"}]
# Preferred unified config for multiple AI agents/providers (override AI_LINKS_JSON if needed)
AI_AGENTS_JSON=[{"id":"openai","title":"OpenAI","enabled":true,"url":"https://chat.openai.com","apiBaseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY"},{"id":"gemini","title":"Gemini","enabled":true,"url":"https://gemini.google.com","apiBaseUrl":"https://generativelanguage.googleapis.com/v1beta","apiKeyEnv":"GEMINI_API_KEY"},{"id":"claude","title":"Claude","enabled":true,"url":"https://claude.ai","apiBaseUrl":"https://api.anthropic.com/v1","apiKeyEnv":"ANTHROPIC_API_KEY"},{"id":"grok","title":"Grok","enabled":true,"url":"https://grok.com","apiBaseUrl":"https://api.x.ai/v1","apiKeyEnv":"XAI_API_KEY"},{"id":"deepseek","title":"DeepSeek","enabled":true,"url":"https://chat.deepseek.com","apiBaseUrl":"https://api.deepseek.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY"},{"id":"qwen","title":"Qwen","enabled":true,"url":"https://chat.qwen.ai","apiBaseUrl":"https://dashscope-intl.aliyuncs.com/compatible-mode/v1","apiKeyEnv":"QWEN_API_KEY"},{"id":"copilot","title":"Copilot","enabled":true,"url":"https://copilot.microsoft.com","apiBaseUrl":"","apiKeyEnv":"COPILOT_TOKEN"}]

# Optional: self-hosted LanguageTool (see docker-compose service hekoti-languagetool)
# Local dev (compose): http://hekoti-languagetool:8010 — from host machine: http://localhost:8010 (publish port if needed)
LANGUAGETOOL_URL=http://hekoti-languagetool:8010

# Webhooks (replace with a long random string in production)
WEBHOOK_SECRET=your-random-hex-here
OUTGOING_WEBHOOK_URLS=

# Optional API keys for AI agents (names must match AI_AGENTS_JSON apiKeyEnv)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
COPILOT_TOKEN=

# Media
ASSETS_BASE_URL=
LOCAL_UPLOAD_DIR=public/uploads
