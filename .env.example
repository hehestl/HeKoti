# Hekoti — пример переменных окружения
# Скопируйте: cp .env.example .env и заполните секреты перед production-деплоем.

# --- Docker Compose: один экземпляр (дефолт chat) ---

# Короткий slug экземпляра — префикс container_name / volumes / internal network.
# Дефолт hekoti → hh-hekoti-app, hh-hekoti-pg, …
HEKOTI_INSTANCE=hekoti

# Неймспейс проекта Compose (задайте вручную: hh-{HEKOTI_INSTANCE})
COMPOSE_PROJECT_NAME=hh-hekoti

# Host-порт UI (pool ui, port-registry). Внутри контейнера всегда 3310.
HEKOTI_HOST_PORT=3310

# Изолированная сеть стека (legacy chat: hh-network)
HEKOTI_DOCKER_NETWORK=hh-network

# Сеть NPM / reverse proxy (external)
NPM_PROXY_NETWORK=proxy-network

# LanguageTool: embedded | external | off
# embedded — LT в этом compose (нужен COMPOSE_PROFILES=embedded-lt)
# external — общий hh-shared-lt (см. deploy/docker-compose.shared-lt.yml)
# off — LANGUAGETOOL_URL пустой
HEKOTI_LT_MODE=embedded
COMPOSE_PROFILES=embedded-lt

# DNS service name Postgres внутри internal-сети (дефолт: hekoti-postgres в том же стеке)
# POSTGRES_HOST=hekoti-postgres
#
# Внешний Postgres (соседний контейнер): deploy/docker-compose.external-db.yml
# HEKOTI_DB_DOCKER_NETWORK=hedra-db
# POSTGRES_HOST=hedra-postgres-postgres-1

# Несколько вики на одной VM: см. `.env.world.example` и docs/README.* (секция multi-instance)

# --- Режим приложения и сеть ---

# development | test | production
NODE_ENV=production

# Порт HTTP-сервера Next.js (в Docker compose пробрасывает 3310:3310)
PORT=3310

# В Docker не задавайте вручную: compose/entrypoint ставят 0.0.0.0, иначе Next привяжется к одному интерфейсу.
# HOSTNAME=0.0.0.0

# Публичный URL сайта (ссылки, JSON-LD, OAuth redirect). За HTTPS-прокси — https://ваш-домен.
# Cookie Secure: если APP_URL начинается с https ИЛИ прокси шлёт X-Forwarded-Proto: https.
APP_URL=http://localhost:3310

# Только если production открывают по plain HTTP (IP:порт без TLS) — иначе Secure-cookie не сохранится.
# SESSION_COOKIE_INSECURE=1

# --- PostgreSQL (Docker Compose) ---

# Три переменные ниже должны совпадать с уже созданным томом Postgres.
# DATABASE_URL в Docker собирается автоматически в docker-entrypoint.sh — задавать не обязательно.
# После смены POSTGRES_* пересоздайте том или выровняйте пароль в существующей БД.
POSTGRES_DB=hekoti_db
POSTGRES_USER=hekoti_user
POSTGRES_PASSWORD=hekoti_password

# Локальная разработка без Docker / внешний Postgres:
# DATABASE_URL=postgresql://hekoti_user:hekoti_password@localhost:5432/hekoti_db?schema=public

# --- Docker: миграции и проверки ---

# 1 — пропустить prisma migrate deploy при старте контейнера
HEKOTI_SKIP_MIGRATE=0

# Перед migrate entrypoint ищет DROP*/TRUNCATE в SQL. При нахождении старт падает, пока не задано одно из:
# HEKOTI_MIGRATE_ALLOW_DESTRUCTIVE=1          — осознанная деструктивная миграция (только этот деплой)
# HEKOTI_SKIP_DESTRUCTIVE_MIGRATION_CHECK=1    — отключить проверку (аварийно, не рекомендуется)

# В Docker entrypoint: HEKOTI_ENFORCE_PROD_SECRETS=1; секреты автогенерируются (см. HEKOTI_AUTO_SECRETS).
# Локально npm run start:prod делает то же. Ручной режим: HEKOTI_AUTO_SECRETS=0 + секреты в .env

# --- Сессии ---

SESSION_COOKIE_NAME=hekoti_session
SESSION_TTL_HOURS=720

# --- Redis ---

# Compose по умолчанию: redis://hekoti-redis:6379 (можно переопределить)
# REDIS_URL=redis://hekoti-redis:6379
REDIS_CACHE_TTL_SECONDS=300

# --- Wiki: режим и языки ---

# true — публичное чтение без логина; false — только для авторизованных
PUBLIC_READ_MODE=true

# Список кодов языков через запятую (должны быть в БД/конфиге wiki)
ENABLED_LANGUAGES=en,ru,de,fr,es,pt-BR,pt-PT,it,ja,ko,zh-CN

# --- SEO и краулеры (опционально; иначе — Global Settings в админке) ---

# Заголовок сайта (вкладка, og:title). Пусто → админка → «Hekoti».
# SITE_TITLE=My Wiki

# Meta description. Пусто → админка → дефолт Hekoti.
# SITE_DESCRIPTION=Self-hosted wiki knowledge archive

# 1 = индексировать сайт, 0 = noindex всего сайта. Не задано → чекбокс в админке.
# SITE_ROBOTS_INDEX=1

# 1 = разрешить AI-краулеры (GPTBot и др.), 0 = Disallow в robots.txt. Не задано → админка.
# AI_CRAWLERS_ALLOW=1

# Дополнительный текст для /llms.txt (markdown). Пусто → поле в админке.
# LLMS_TXT_EXTRA=

# --- Bootstrap администратора ---

# После migrate docker-entrypoint вызывает scripts/ensure-admin.ts.
# Пустая таблица User → создаётся этот логин. Смена пароля — в админке → Account.
HEKOTI_ADMIN_EMAIL=admin
HEKOTI_ADMIN_PASSWORD=hehe

# 1 — при каждом старте перезаписать пароль указанного email (аварийный сброс)
# HEKOTI_FORCE_ADMIN_RESET=0

# --- Секреты production ---

# По умолчанию (HEKOTI_AUTO_SECRETS=1) docker-entrypoint генерирует случайные значения при первом
# старте и сохраняет в ${LOCAL_UPLOAD_DIR}/.hekoti/runtime-secrets.env (том uploads).
# Явно заданные в .env (≥32 символов) имеют приоритет. Отключить автоген: HEKOTI_AUTO_SECRETS=0
# HEKOTI_SECRETS_FILE=/app/public/uploads/.hekoti/runtime-secrets.env

# WEBHOOK_SECRET=
# AUTH_PENDING_SECRET=
# HEKOTI_TOTP_ENCRYPTION_KEY=

# Подпись CSRF-токенов в middleware. Не задан — используется WEBHOOK_SECRET.
# CSRF_SECRET=

# --- Донаты и меню AI (JSON в одну строку) ---

DONATE_LINKS_JSON=[{"title":"Boosty","url":"https://boosty.to/yourname"},{"title":"Patreon","url":"https://patreon.com/yourname"}]
CRYPTO_DONATION_JSON=[{"asset":"USDT","network":"TON","address":"UQ..."}]
AI_LINKS_JSON=[{"title":"ChatGPT","url":"https://chat.openai.com"},{"title":"Claude","url":"https://claude.ai"}]

# Предпочтительный конфиг нескольких AI-агентов (имена apiKeyEnv → переменные ниже)
AI_AGENTS_JSON=[{"id":"openai","title":"OpenAI","enabled":true,"url":"https://chat.openai.com","apiBaseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY"},{"id":"gemini","title":"Gemini","enabled":true,"url":"https://gemini.google.com","apiBaseUrl":"https://generativelanguage.googleapis.com/v1beta","apiKeyEnv":"GEMINI_API_KEY"},{"id":"claude","title":"Claude","enabled":true,"url":"https://claude.ai","apiBaseUrl":"https://api.anthropic.com/v1","apiKeyEnv":"ANTHROPIC_API_KEY"},{"id":"grok","title":"Grok","enabled":true,"url":"https://grok.com","apiBaseUrl":"https://api.x.ai/v1","apiKeyEnv":"XAI_API_KEY"},{"id":"deepseek","title":"DeepSeek","enabled":true,"url":"https://chat.deepseek.com","apiBaseUrl":"https://api.deepseek.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY"},{"id":"qwen","title":"Qwen","enabled":true,"url":"https://chat.qwen.ai","apiBaseUrl":"https://dashscope-intl.aliyuncs.com/compatible-mode/v1","apiKeyEnv":"QWEN_API_KEY"},{"id":"copilot","title":"Copilot","enabled":true,"url":"https://copilot.microsoft.com","apiBaseUrl":"","apiKeyEnv":"COPILOT_TOKEN"}]

# Ключи API для агентов (имена должны совпадать с apiKeyEnv в AI_AGENTS_JSON)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
COPILOT_TOKEN=

# --- LanguageTool (орфография, /api/spellcheck) ---

# Self-hosted сервис hekoti-languagetool в compose. Пустое значение — spellcheck отключён.
LANGUAGETOOL_URL=http://hekoti-languagetool:8010

# --- Исходящие webhooks ---

# URL через запятую для уведомлений о событиях wiki
OUTGOING_WEBHOOK_URLS=

# --- Медиа и загрузки ---

# Базовый URL CDN для статики (пусто — относительные пути с APP_URL)
ASSETS_BASE_URL=
LOCAL_UPLOAD_DIR=public/uploads

# local — файлы в LOCAL_UPLOAD_DIR; s3 — S3-compatible bucket (prod)
MEDIA_STORAGE=local

# S3-compatible (AWS S3, MinIO, Yandex Object Storage и т.д.)
# S3_ENDPOINT=https://minio.example.com
# S3_REGION=us-east-1
# S3_BUCKET=hekoti-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com

# Лимиты загрузки (байты; по умолчанию 10 МБ изображения, 100 МБ видео)
# MEDIA_MAX_IMAGE_BYTES=10485760
# MEDIA_MAX_VIDEO_BYTES=104857600
# MEDIA_PRESIGN_TTL_SECONDS=900

# --- Heron Auth SSO (опционально) ---
# Prod wiki.hehestl.com: HEKOTI_HERON_AUTH_ENABLED=1, APP_URL=https://wiki.hehestl.com,
# JWT vars — скопировать с heron-auth. См. docs/auth-heron.md

# 0 — локальный логин; 1 — вход через Heron OAuth
HEKOTI_HERON_AUTH_ENABLED=0

# Публичный URL Heron (кнопка «Войти через Heron» в браузере)
# NEXT_PUBLIC_HERON_AUTH_URL=https://heron.hehestl.com

# Публичный URL этой wiki для OAuth redirect (если не задан — fallback в коде)
# NEXT_PUBLIC_APP_URL=https://wiki.hehestl.com

# Серверный URL API Heron (обмен code → JWT)
# HERON_AUTH_API_URL=https://heron.hehestl.com

# Проверка JWT от Heron
# HERON_JWT_ISSUER=https://heron.hehestl.com
# HERON_JWT_AUDIENCE=hehe-ecosystem
# Prod: HERON_JWT_PUBLIC_KEY_PATH=/run/secrets/heron_jwt_public.pem
# Dev:  HERON_JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----...

# Таймаут fetch к Heron, мс (по умолчанию в коде — 10000)
# HERON_FETCH_TIMEOUT_MS=10000

# Куда редиректить после успешного SSO
HEKOTI_HERON_DEFAULT_RETURN=/ru/admin

# Лимит запросов на /api/auth/heron/exchange (за окно rate limiter)
HEKOTI_HERON_EXCHANGE_RATE_LIMIT=20
