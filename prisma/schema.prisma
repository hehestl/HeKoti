generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  READER
}

enum PageReaction {
  BROKEN
  NEUTRAL
  LOVED
}

enum PageScope {
  WIKI
  NOTES
}

enum MediaKind {
  IMAGE
  VIDEO
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String?
  heronSubjectId String?   @unique
  role           UserRole  @default(READER)
  totpSecret     String?
  isTotpEnabled  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  pageRevisions  PageRevision[]
  agentMessages  AgentMessage[]
  pageRatings    PageRating[]
  mediaAssets    MediaAsset[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Page {
  id           String         @id @default(uuid())
  title        String
  slug         String
  lang         String         @default("en")
  path         String
  navOrder     Int            @default(0)
  contentMd    String         @default("")
  searchText   String         @default("")
  excerpt      String?
  icon         String?
  isCategory   Boolean        @default(false)
  isPublished  Boolean        @default(false)
  showToc      Boolean        @default(true)
  scope        PageScope      @default(WIKI)
  systemKey    String?
  parentId     String?
  originalId   String?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  parent       Page?          @relation("PageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     Page[]         @relation("PageChildren")
  revisions    PageRevision[]
  ratings      PageRating[]

  @@index([lang, slug])
  @@index([lang, scope])
  @@index([isCategory])
  @@index([deletedAt])
  @@index([lang, deletedAt])
  @@unique([lang, systemKey])
}

model PageRevision {
  id          String   @id @default(uuid())
  pageId      String
  editorId    String
  createdAt   DateTime @default(now())

  title       String
  contentMd   String   @default("")
  slug        String?
  path        String?
  icon        String?
  isPublished Boolean?
  showToc     Boolean?
  isCategory  Boolean?
  navOrder    Int?

  contentHash String?
  sizeBytes   Int?
  summary     String?

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor      User     @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt(sort: Desc)])
}

model PageRating {
  id        String       @id @default(uuid())
  pageId    String
  userId    String
  reaction  PageReaction
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  page      Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
}

model AgentChannel {
  id            String         @id @default(uuid())
  key           String         @unique
  title         String
  activeAgentId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      AgentMessage[]
}

model AgentMessage {
  id         String       @id @default(uuid())
  channelId  String
  authorId   String?
  role       String
  content    String
  createdAt  DateTime     @default(now())
  channel    AgentChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

model GlobalSettings {
  id                   String   @id @default("default")
  defaultLanguage      String   @default("en")
  adminLanguage        String   @default("en")
  headHtml             String   @default("")
  bodyHtml             String   @default("")
  /** JSON array of enabled locale codes; empty = use ENABLED_LANGUAGES env. */
  enabledLanguagesJson String   @default("")
  /** JSON array of {id, enabled} overrides for AI agents; empty = use AI_AGENTS_JSON env. */
  aiAgentsJson         String   @default("")
  wikiTreeGuideColor   String?
  /** JSON donate platforms; empty = DONATE_LINKS_JSON env fallback. */
  donateLinksJson      String   @default("")
  /** JSON crypto wallets; empty = CRYPTO_DONATION_JSON env fallback. */
  cryptoDonationJson   String   @default("")
  /** JSON contact links on donate page. */
  donateContactsJson   String   @default("")
  /** Site title when SITE_TITLE env is empty. */
  siteTitle            String   @default("")
  /** Meta description when SITE_DESCRIPTION env is empty. */
  siteDescription      String   @default("")
  /** Allow search engine indexing when SITE_ROBOTS_INDEX env is unset. */
  robotsIndexSite      Boolean  @default(true)
  /** Allow AI crawlers when AI_CRAWLERS_ALLOW env is unset. */
  aiCrawlersAllow      Boolean  @default(true)
  /** Extra llms.txt body when LLMS_TXT_EXTRA env is empty. */
  llmsTxtExtra         String   @default("")
  /** Site mascot: hekoti | hehel */
  mascotId             String   @default("hekoti")
  updatedAt            DateTime @updatedAt
}

model PageRedirect {
  id        String   @id @default(uuid())
  lang      String
  fromPath  String
  toPath    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([lang, fromPath])
  @@index([expiresAt])
}

model MediaAsset {
  id           String    @id @default(uuid())
  storageKey   String    @unique
  publicUrl    String
  filename     String
  mimeType     String
  kind         MediaKind
  sizeBytes    Int
  width        Int?
  height       Int?
  uploadedById String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([kind, deletedAt, createdAt])
  @@index([uploadedById])
}

model AuditLog {
  id           String   @id @default(uuid())
  eventType    String
  userId       String?
  userEmail    String?
  action       String?
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     String?  // JSON stringified
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
  @@index([ipAddress])
}
