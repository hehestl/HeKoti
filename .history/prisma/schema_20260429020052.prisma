generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  role           String    @default("admin")
  totpSecret     String?
  isTotpEnabled  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  pageRevisions  PageRevision[]
  agentMessages  AgentMessage[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Page {
  id           String         @id @default(uuid())
  title        String
  slug         String
  lang         String         @default("en")
  path         String         @unique
  navOrder     Int            @default(0)
  contentMd    String         @default("")
  excerpt      String?
  isPublished  Boolean        @default(false)
  parentId     String?
  originalId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  parent       Page?          @relation("PageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     Page[]         @relation("PageChildren")
  revisions    PageRevision[]

  @@index([lang, slug])
}

model PageRevision {
  id          String   @id @default(uuid())
  pageId      String
  editorId    String
  title       String
  contentMd   String
  createdAt   DateTime @default(now())
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor      User     @relation(fields: [editorId], references: [id], onDelete: Cascade)
}

model AgentChannel {
  id            String         @id @default(uuid())
  key           String         @unique
  title         String
  activeAgentId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      AgentMessage[]
}

model AgentMessage {
  id         String       @id @default(uuid())
  channelId  String
  authorId   String?
  role       String
  content    String
  createdAt  DateTime     @default(now())
  channel    AgentChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

model GlobalSettings {
  id              String   @id @default("default")
  defaultLanguage String   @default("en")
  updatedAt       DateTime @updatedAt
}
