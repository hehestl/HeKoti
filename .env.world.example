# Hekoti world на hemonea: https://w.hehestl.su (порт host 3311)
# cp .env.world.example .env && заполните пароли
#
# Runbook: docs/ops-world-hemonea-deploy.md
# Deploy: /opt/app/prod/hh-world
#   NO_CACHE=1 sh scripts/deploy-update.sh

HEKOTI_INSTANCE=world
COMPOSE_PROJECT_NAME=hh-world
HEKOTI_HOST_PORT=3311
HEKOTI_APP_PORT=3310
HEKOTI_DOCKER_NETWORK=hh-world-net

# Traefik (hemonea) — обязателен deploy/docker-compose.wiki-prod.yml
TRAEFIK_PROXY_NETWORK=hehe-net
HEKOTI_PUBLIC_HOST=w.hehestl.su
HEKOTI_DB_DOCKER_NETWORK=hh-network

# LanguageTool: off (или external + hh-shared-net)
HEKOTI_LT_MODE=off
COMPOSE_PROFILES=
LANGUAGETOOL_URL=

NODE_ENV=production
PORT=3310
APP_URL=https://w.hehestl.su
NEXT_PUBLIC_APP_URL=https://w.hehestl.su

POSTGRES_DB=hekoti_world_db
POSTGRES_USER=hekoti_world_user
POSTGRES_PASSWORD=change-me-unique-password
POSTGRES_HOST=hedra-postgres-postgres-1

REDIS_URL=redis://dragonfly:6379

SESSION_COOKIE_NAME=hekoti_world_session
SESSION_TTL_HOURS=720

PUBLIC_READ_MODE=true
ENABLED_LANGUAGES=en,ru

HEKOTI_ADMIN_EMAIL=admin
HEKOTI_ADMIN_PASSWORD=change-me-after-first-login

HEKOTI_SKIP_MIGRATE=0
LOCAL_UPLOAD_DIR=public/uploads
MEDIA_STORAGE=local

DONATE_LINKS_JSON=[]
CRYPTO_DONATION_JSON=[]
AI_LINKS_JSON=[]
AI_AGENTS_JSON=[]

# --- Heron SSO (OAuth client hekoti-wiki + redirect w.hehestl.su) ---
HEKOTI_HERON_AUTH_ENABLED=1
HEKOTI_HERON_DEFAULT_RETURN=/ru/admin
NEXT_PUBLIC_HERON_AUTH_URL=https://id.hehestl.su
NEXT_PUBLIC_HERON_OAUTH_CLIENT_ID=hekoti-wiki
HERON_AUTH_API_URL=https://id.hehestl.su
HERON_JWT_ISSUER=https://id.hehestl.su
HERON_JWT_AUDIENCE=hekoti-wiki
HERON_OAUTH_CLIENT_ID=hekoti-wiki
HERON_JWT_PUBLIC_KEY_PATH=/run/secrets/heron_jwt_public.pem

# PEM: cp /opt/app/prod/hh-heron-auth/secrets/heron_jwt_public.pem secrets/heron_jwt_public.pem
# (файл, не каталог — иначе Docker создаст пустую папку)
# Маскот: cp /opt/app/prod/hh-wiki/public/hekoti.png public/hekoti.png
