# Hekoti — второй экземпляр (пример: world на порту 3311)
# Скопируйте: cp .env.world.example .env и заполните секреты (openssl rand -hex 32).

HEKOTI_INSTANCE=world
COMPOSE_PROJECT_NAME=hh-world
HEKOTI_HOST_PORT=3311
HEKOTI_DOCKER_NETWORK=hh-world-net
NPM_PROXY_NETWORK=proxy-network

# Shared LanguageTool (поднять один раз: deploy/docker-compose.shared-lt.yml)
HEKOTI_LT_MODE=external
# COMPOSE_PROFILES пуст — без embedded-lt
LANGUAGETOOL_URL=http://hh-shared-lt:8010
# Запуск: docker compose -f docker-compose.yml -f deploy/docker-compose.external-lt.yml up -d

NODE_ENV=production
PORT=3310
APP_URL=https://world.example.com

POSTGRES_DB=hekoti_world_db
POSTGRES_USER=hekoti_world_user
POSTGRES_PASSWORD=change-me-unique-password
POSTGRES_HOST=hekoti-postgres

SESSION_COOKIE_NAME=hekoti_world_session
SESSION_TTL_HOURS=720

PUBLIC_READ_MODE=true
ENABLED_LANGUAGES=en,ru

HEKOTI_ADMIN_EMAIL=admin
HEKOTI_ADMIN_PASSWORD=change-me-after-first-login

# Обязательны в production (каждый ≥32 символов): openssl rand -hex 32
WEBHOOK_SECRET=
AUTH_PENDING_SECRET=
HEKOTI_TOTP_ENCRYPTION_KEY=

REDIS_URL=redis://hekoti-redis:6379
REDIS_CACHE_TTL_SECONDS=300

HEKOTI_SKIP_MIGRATE=0
LOCAL_UPLOAD_DIR=public/uploads
MEDIA_STORAGE=local

DONATE_LINKS_JSON=[]
CRYPTO_DONATION_JSON=[]
AI_LINKS_JSON=[]
AI_AGENTS_JSON=[]
HEKOTI_HERON_AUTH_ENABLED=0
HEKOTI_HERON_DEFAULT_RETURN=/ru/admin
