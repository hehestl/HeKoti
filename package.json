{
  "name": "hekoti",
  "version": "0.4.8",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/install-banner.cjs",
    "dev": "node scripts/bundle-monaco-workers.mjs && next dev",
    "build": "node scripts/bundle-monaco-workers.mjs && prisma generate && next build",
    "start": "node scripts/start-production.cjs",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "check:hh-standards": "node scripts/check-hh-standards.cjs",
    "preversion": "npm run lint",
    "version:write": "node scripts/write-version.cjs",
    "postversion": "npm run version:write",
    "release": "npm run release:patch",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "search:reindex": "tsx scripts/reindex-page-search.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "bcryptjs": "^3.0.3",
    "dompurify": "3.4.5",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "jsdom": "^29.1.1",
    "lru-cache": "^11.3.5",
    "lucide-react": "^1.11.0",
    "marked": "^18.0.2",
    "mermaid": "^11.15.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "svgdom": "^0.1.23",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@rolldown/binding-wasm32-wasi": {
      "@emnapi/core": "1.11.1",
      "@emnapi/runtime": "1.11.1"
    },
    "eslint": "9.39.4",
    "hono": "4.12.21",
    "@hono/node-server": "2.0.3",
    "fast-uri": "3.1.2",
    "dompurify": "3.4.5",
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/svgdom": "^0.1.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.25.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "monaco-editor": "^0.52.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
